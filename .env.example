# ---- Model provider ----
# "gemini" or "openrouter". Only the selected provider's key is required.
LLM_PROVIDER=gemini

# --- Gemini (LLM_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.7-flash

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Free tier, useful when Gemini rate-limits. Key: https://openrouter.ai/keys
#
# NOTE: free accounts get 50 requests/day and 20/minute. One question costs
# several requests (search -> fetch -> answer), so that's roughly 12-20
# questions a day across everyone. Buying $10 of credit once raises it to
# 1000/day permanently.
#
# The model MUST support tool calling or the agent cannot read Notion at all.
# Check before switching:
#   curl -s https://openrouter.ai/api/v1/models \
#     | python3 -c "import json,sys; [print(m['id']) for m in json.load(sys.stdin)['data'] if m.get('pricing',{}).get('prompt') in ('0','0.0') and 'tools' in (m.get('supported_parameters') or [])]"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ---- Security ----
# Signs the session cookie. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-random-32-byte-urlsafe-string

# Encrypts Notion tokens at rest (Fernet key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=change-me-to-a-fernet-key

# ---- OAuth: Notion ----
# Must exactly match what the backend serves. Notion redirects here after consent.
# Notion self-registers its OAuth client, so there is nothing to create by hand.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Where the browser lands after auth completes (your frontend).
FRONTEND_URL=http://localhost:5173

# ---- OAuth: Google Sheets ----
# Unlike Notion, Google has no dynamic client registration — create an OAuth
# client by hand (see README "Connecting Google Sheets"). Leave blank and the
# Sheets connection is hidden rather than failing at runtime.
#
# The redirect URI must be listed verbatim as an Authorised redirect URI on
# the credential in Google Cloud Console, or consent fails with redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---- Storage ----
# Leave BOTH blank for local development: state goes to a file in STATE_DIR.
#
# Set BOTH when deploying to Vercel (or any serverless host). Serverless
# wipes the filesystem between requests and spreads consecutive requests
# across instances, so tokens, PKCE state and chat history must live in
# Redis instead. Free tier: https://console.upstash.com
#
# Every record stays keyed by user — Redis is shared between *server
# instances*, never between users. Notion tokens are encrypted with
# TOKEN_ENC_KEY before they are written, so the Redis host cannot read them.
REDIS_URL=
REDIS_TOKEN=

# ---- Optional ----
# Fallback root page ID, used if notion-search is unavailable
# (workspace lacks Notion AI). Find it in the page URL.
NOTION_ROOT_PAGE_ID=

# Local-only: where state is persisted when Redis is not configured.
STATE_DIR=.state
