# Keep the function bundle small. Python has no tree-shaking on Vercel, so
# everything reachable at build time is included unless excluded here.
#
# NOTE: frontend/dist is deliberately NOT excluded -- FastAPI mounts it to
# serve the SPA, and Vercel promotes those files to the CDN at build time.

tests/
.venv/
.state/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Frontend sources are needed at BUILD time (tsc + vite run on Vercel), so
# only node_modules is excluded -- npm install regenerates it. Excluding
# tsconfig.json/src/index.html here breaks the build with TS5083.
frontend/node_modules/
*.tsbuildinfo

.git/
.env
README.md
